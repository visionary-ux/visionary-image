{
  "name": "visionary-image",
  "description": "Visionary Image — The easiest way to Blurhash. Renders true-to-size placeholders that eliminate layout shift and crush Core Web Vitals. SSR-ready React & Web Components.",
  "version": "1.1.0",
  "homepage": "https://visionary.cloud",
  "type": "module",
  "main": "./dist/visionary-image.umd.js",
  "module": "./dist/visionary-image.es.js",
  "source": "./src/index.ts",
  "types": "./dist/visionary-image.d.ts",
  "exports": {
    ".": {
      "types": "./dist/visionary-image.d.ts",
      "import": "./dist/visionary-image.es.js",
      "require": "./dist/visionary-image.umd.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./blurhash": {
      "types": "./dist/blurhash.d.ts",
      "import": "./dist/blurhash.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js"
    },
    "./web-component/register": {
      "types": "./dist/web-component/register.d.ts",
      "import": "./dist/web-component/register.js"
    }
  },
  "sideEffects": [
    "./dist/loader.js",
    "./dist/web-component/register.js"
  ],
  "license": "ISC",
  "scripts": {
    "build": "tsc && pnpm run clean && vite build && vite build --config vite.config.autoload.ts",
    "build-storybook": "storybook build -o storybook-static",
    "clean": "rimraf dist/",
    "dev": "vite",
    "lint": "tsc --noEmit; eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "packageManager": "pnpm@11.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visionary-ux/visionary-image.git"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "fast-blurhash": "1.1.4",
    "visionary-url": "1.3.3"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "devDependencies": {
    "@storybook/react": "10.4.4",
    "@storybook/react-vite": "10.4.4",
    "@testing-library/react": "16.3.1",
    "@types/node": "20.19.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitejs/plugin-legacy": "8.0.2",
    "@vitejs/plugin-react-swc": "4.3.1",
    "eslint": "10.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-storybook": "10.4.6",
    "eslint-plugin-typescript-sort-keys": "3.3.0",
    "jsdom": "29.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "6.1.2",
    "sass": "1.97.1",
    "storybook": "10.4.6",
    "storybook-dark-mode": "5.0.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vite-plugin-css-injected-by-js": "5.0.1",
    "vite-plugin-dts": "5.0.2",
    "vitest": "4.1.8",
    "vitest-canvas-mock": "1.1.3"
  },
  "keywords": [
    "blurhash",
    "cls",
    "component",
    "core-web-vitals",
    "fcp",
    "fid",
    "image",
    "inp",
    "lcp",
    "performance",
    "placeholder",
    "react",
    "seo",
    "speed",
    "typescript",
    "visionary",
    "web-component",
    "web-vitals"
  ]
}
