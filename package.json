{
  "name": "visionary-image",
  "description": "The easiest way to use Blurhash in React and Web Components. True-to-size, SSR-ready placeholders that paint on the Critical Rendering Path and improve Core Web Vitals.",
  "version": "1.1.2",
  "homepage": "https://visionary.cloud",
  "type": "module",
  "main": "./dist/visionary-image.cjs",
  "module": "./dist/visionary-image.es.js",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/visionary-image.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/visionary-image.cjs"
      }
    },
    "./loader": {
      "import": {
        "types": "./dist/loader.d.ts",
        "default": "./dist/loader.js"
      },
      "require": {
        "types": "./dist/loader.d.cts",
        "default": "./dist/loader.cjs"
      }
    },
    "./blurhash": {
      "import": {
        "types": "./dist/blurhash.d.ts",
        "default": "./dist/blurhash.js"
      },
      "require": {
        "types": "./dist/blurhash.d.cts",
        "default": "./dist/blurhash.cjs"
      }
    },
    "./web-component": {
      "import": {
        "types": "./dist/web-component.d.ts",
        "default": "./dist/web-component.js"
      },
      "require": {
        "types": "./dist/web-component.d.cts",
        "default": "./dist/web-component.cjs"
      }
    },
    "./web-component/register": {
      "import": {
        "types": "./dist/web-component/register.d.ts",
        "default": "./dist/web-component/register.js"
      },
      "require": {
        "types": "./dist/web-component/register.d.cts",
        "default": "./dist/web-component/register.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "loader": [
        "./dist/loader.d.ts"
      ],
      "blurhash": [
        "./dist/blurhash.d.ts"
      ],
      "web-component": [
        "./dist/web-component.d.ts"
      ],
      "web-component/register": [
        "./dist/web-component/register.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/loader.js",
    "./dist/loader.cjs",
    "./dist/web-component/register.js",
    "./dist/web-component/register.cjs"
  ],
  "license": "ISC",
  "scripts": {
    "build": "tsc && pnpm run clean && vite build && vite build --config vite.config.autoload.ts && pnpm run build:cts",
    "build:cts": "node scripts/copy-cts.mjs",
    "build-storybook": "storybook build -o storybook-static",
    "clean": "rimraf dist/",
    "dev": "vite",
    "lint": "tsc --noEmit; eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "vitest run",
    "test:browser": "pnpm run build && vitest run --config test/config/vitest.browser.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:worker": "pnpm run build && vitest run --config test/config/vitest.worker.config.ts",
    "types:validate": "attw --pack ."
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "packageManager": "pnpm@11.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visionary-ux/visionary-image.git"
  },
  "dependencies": {
    "blurhash-url": "1.4.1",
    "classnames": "2.5.1",
    "fast-blurhash": "1.2.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@microsoft/api-extractor": "^7.58.11",
    "@storybook/react": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitest/browser-playwright": "4.1.8",
    "@vitejs/plugin-legacy": "8.0.2",
    "@vitejs/plugin-react-swc": "4.3.1",
    "eslint": "10.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-storybook": "10.5.0",
    "eslint-plugin-typescript-sort-keys": "3.3.0",
    "jsdom": "29.1.1",
    "playwright": "1.62.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "6.1.2",
    "sass": "1.97.1",
    "storybook": "10.5.0",
    "storybook-dark-mode": "5.0.0",
    "typescript": "5.9.3",
    "unplugin-dts": "^1.0.3",
    "vite": "8.1.4",
    "vite-plugin-css-injected-by-js": "5.0.1",
    "vitest": "4.1.8",
    "vitest-canvas-mock": "1.1.3"
  },
  "keywords": [
    "blurhash",
    "cls",
    "component",
    "core-web-vitals",
    "fcp",
    "fid",
    "image",
    "inp",
    "lcp",
    "performance",
    "placeholder",
    "react",
    "seo",
    "speed",
    "typescript",
    "visionary",
    "web-component",
    "web-vitals"
  ]
}
