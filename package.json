{
  "name": "visionary-image",
  "description": "React image component with built-in Blurhash placeholders for better UX and Core Web Vitals.",
  "version": "1.0.6",
  "homepage": "https://visionary.cloud",
  "type": "module",
  "main": "./dist/visionary-image.umd.js",
  "module": "./dist/visionary-image.es.js",
  "source": "./src/index.ts",
  "types": "./dist/visionary-image.d.ts",
  "exports": {
    ".": {
      "types": "./dist/visionary-image.d.ts",
      "import": "./dist/visionary-image.es.js",
      "require": "./dist/visionary-image.umd.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./blurhash": {
      "types": "./dist/blurhash.d.ts",
      "import": "./dist/blurhash.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "license": "ISC",
  "scripts": {
    "build": "tsc && npm run clean && vite build && vite build --config vite.config.autoload.ts",
    "build-storybook": "storybook build -o storybook-static",
    "clean": "rimraf dist/",
    "dev": "vite",
    "lint": "tsc --noEmit; eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visionary-ux/visionary-image.git"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "fast-blurhash": "1.1.4",
    "visionary-url": "1.3.3"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "devDependencies": {
    "@storybook/react": "10.1.10",
    "@storybook/react-vite": "10.1.10",
    "@testing-library/react": "16.3.1",
    "@types/node": "20.19.6",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.15.0",
    "@vitejs/plugin-legacy": "7.2.1",
    "@vitejs/plugin-react-swc": "4.2.2",
    "eslint": "8.57.0",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.9",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-storybook": "0.8.0",
    "eslint-plugin-typescript-sort-keys": "3.2.0",
    "jsdom": "27.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "6.1.2",
    "sass": "1.97.1",
    "storybook": "10.1.10",
    "storybook-dark-mode": "4.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vite-plugin-css-injected-by-js": "3.5.2",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.0.16",
    "vitest-canvas-mock": "1.1.3"
  },
  "keywords": [
    "blurhash",
    "cls",
    "component",
    "core-web-vitals",
    "fcp",
    "fid",
    "image",
    "inp",
    "lcp",
    "performance",
    "placeholder",
    "react",
    "seo",
    "speed",
    "typescript",
    "visionary",
    "web-component",
    "web-vitals"
  ]
}
